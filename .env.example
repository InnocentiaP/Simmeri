SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-only. Never prefix this with VITE_ — that would ship it to the client bundle.
# Only required if a genuinely admin/service-role server task is added; unused by the
# course-submission MVP's normal auth/session flow.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Never prefix this with VITE_ — used only by
# src/lib/import/gemini-client.server.ts for the AI Recipe Import Assistant
# ("Improve with AI" on /app/recipes/import). The browser never calls Gemini
# directly and never receives this value.
GEMINI_API_KEY= 
